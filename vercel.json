{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "assets/**",
          "bots/**",
          "loaders/**",
          "static/**",
          "translations/**",
          "docs/**",
          "index.html",
          "manifest.json",
          "brand.config.js"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ]
}

